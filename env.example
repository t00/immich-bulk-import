# Config for build.sh and run.sh. Copy to .env, then: chmod 600 .env
#
# Both scripts look for this file in order:
#   $IMMICH_ENV_FILE  >  <dir containing the scripts>/.env  >  ~/.config/immich/.env
#
# This file is BOTH sourced by bash and passed to `docker --env-file`, so it
# must contain only KEY=value lines -- no 'export', no command substitution,
# and NO inline comments (docker would swallow them into the value).
# docker --env-file does NOT strip quotes, so leave UNQUOTED any value that is
# read inside the container (API key, URL, passphrase). IMMICH_CERT_DIR is
# host-side only, so quote it if the path contains spaces -- unquoted, `sh`
# would try to run the second word as a command.
#
# The photo directory is NOT configured here: pass it as the last argument to
# run.sh, e.g.  ./run.sh --go /srv/photos

# --- server ----------------------------------------------------------------
# Must end in /api
IMMICH_INSTANCE_URL=https://immich.example.com/api
IMMICH_API_KEY=paste_your_api_key_here

# CLI's own default is 1, which is very slow for bulk imports.
IMMICH_UPLOAD_CONCURRENCY=6

# Pin to YOUR SERVER'S version -- the CLI ships from the same repo and release
# tag as the server, so `latest` on npm may be ahead of your server and break.
# Check the server version with ./run.sh --check (or the web UI's About page).
# If npm has no CLI for your exact version, use the highest one below it:
#   curl -s https://registry.npmjs.org/@immich/cli | jq -r '.versions|keys[]'
# (Example of the breakage: CLI 3.x dropped deviceAssetId/deviceId from the
# upload form, so every asset fails with HTTP 400 against a 2.x server.)
IMMICH_CLI_VERSION=2.7.5

# --- mTLS (optional; delete these lines if your server doesn't use it) ------
# Host dir, mounted read-only at /certs (absolute, ~/... or relative-to-this-
# file). Files MUST be named:
#   client.crt   client.key   ca.crt (optional, private CA only)
# Cert filenames below are resolved INSIDE the container's /certs mount, so
# give bare filenames -- never a host path like /home/me/certs/client.crt.
IMMICH_CERT_DIR=/etc/immich/certs

# Only if your client key is passphrase-protected:
# IMMICH_CLIENT_PASSPHRASE=changeit

# PKCS#12 instead of PEM: put the .pfx/.p12 in the cert dir above and give
# its bare FILENAME here (no client.crt/client.key needed in that case).
# IMMICH_CLIENT_PFX=hass.pfx
